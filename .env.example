PORT=8000
NODE_ENV=development
USE_MONGODB=true

MONGODB_URI=mongodb://localhost:27017/health_app

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_second_long_random_secret
JWT_REFRESH_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PARTNER_PORTAL_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-web-oauth-client-id

# Cloudinary profile image storage (images are never saved to local disk).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=health-goals/profile-images

# Encrypt partner reward codes in MongoDB; keep this key stable and private.
VOUCHER_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32

# Only these emails may access the admin dashboard (comma-separated).
ADMIN_EMAILS=
# Required for email OTP. Never put these credentials in the frontend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# dev: fixed OTP 123456, no email. live: random OTP sent by email.
APP_MODE=live

# Process due user/day coins in batches of 20, max 2 concurrently.
SETTLEMENT_ENABLED=true

# Vercel Cron: set the same random secret in Vercel Project Environment Variables.
CRON_SECRET=
